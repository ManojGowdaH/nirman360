# Public site configuration. These values are visible in the browser.
# Leave a value empty until it is confirmed. Do not invent contact details.

NEXT_PUBLIC_SITE_URL=https://nirman360.in
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Only a real https://play.google.com listing. Leave empty to show Coming Soon.
NEXT_PUBLIC_GOOGLE_PLAY_URL=

# Legal name and registered address. Leave empty until the business confirms them.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=

# Set to true only after the mobile app has a working in-app account deletion control.
NEXT_PUBLIC_IN_APP_ACCOUNT_DELETION=false

# Server-only. Never prefix the service-role key with NEXT_PUBLIC_.
# Use either Supabase or the webhook. Supabase is used when both are set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Optional salt for hashing visitor network addresses stored with form requests.
IP_HASH_SALT=
